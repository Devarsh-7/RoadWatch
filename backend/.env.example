# =================================================================
# RoadWatch Backend Production Environment Variables Template
# =================================================================

# Deployment Environment: "development" or "production"
# When set to "production", strict security checks are enforced:
# - Default/weak JWT secrets are rejected immediately
# - Debug exception stack traces are masked from clients
# - HTTPS redirection and strict security headers are enforced
ENVIRONMENT=production

# Enforce HTTPS redirect for all incoming plain HTTP traffic (true/false)
ENFORCE_HTTPS=true

# Cryptographically Secure JWT Secret (MINIMUM 32 characters required in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_minimum_32_char_cryptographically_secure_random_jwt_secret_here

# JWT Token Expiry in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection URL (Supabase PostgreSQL via Transaction Pooler)
# Note: For production, sslmode=require is automatically appended for security.
# Format: postgresql://<db_user>:<db_password>@<db_host>:6543/<db_name>?sslmode=require
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:6543/<db_name>?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Google Gemini API Key for AI Chatbot (RAG)
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated list of trusted production origins)
# Example: https://roadwatch.in,https://roadwatch.vercel.app
ALLOWED_ORIGINS=https://roadwatch.vercel.app,http://localhost:5173

